rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {

    // Countries, continents, POIs — public read
    match /countries/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /continents/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /pois/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Username index — public read (needed for profile lookup)
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User profiles — public read, owner write
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Travel entries subcollection — public read, owner write
      match /travelEntries/{entryId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}

